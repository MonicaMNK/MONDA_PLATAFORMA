digraph G {
graph [fontname="Arial", bgcolor="white", nodesep=0.35, ranksep=0.45, pad=0.25]; node [fontname="Arial", fontsize=13, shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#64748b", margin="0.14,0.10"]; edge [fontname="Arial", fontsize=11, color="#475569", arrowsize=0.7];
rankdir=TB; start [shape=circle,label="",fillcolor=black,width=.12]; end [shape=doublecircle,label="",fillcolor=black,width=.16];start -> n0;
n0 [label="PWA recupera conexión",shape=box];
n1 [label="M1 revalida sesión y permisos",shape=box];
n2 [label="M8 revisa tipo y clave de acción",shape=box];
n3 [label="¿Acción ya aplicada?",shape=diamond,fillcolor=white];
n4 [label="Comparar versión y aplicar en transacción",shape=box];
n5 [label="Confirmar resultado y actualizar cola",shape=box];
n0 -> n1;
n1 -> n2;
n2 -> n3;
n3 -> n4 [label="No"];
n4 -> n5;
error [label="Devolver resultado previo
sin repetir la acción"]; n3 -> error [label="Sí"];error -> end;n5 -> end;
}