digraph G {
graph [fontname="Arial", bgcolor="white", nodesep=0.35, ranksep=0.45, pad=0.25]; node [fontname="Arial", fontsize=13, shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#64748b", margin="0.14,0.10"]; edge [fontname="Arial", fontsize=11, color="#475569", arrowsize=0.7];
rankdir=TB; start [shape=circle,label="",fillcolor=black,width=.12]; end [shape=doublecircle,label="",fillcolor=black,width=.16];start -> n0;
n0 [label="Usuario envía credenciales",shape=box];
n1 [label="M1 valida identidad y estado",shape=box];
n2 [label="¿Acceso válido?",shape=diamond,fillcolor=white];
n3 [label="M1 crea sesión y verifica RBAC",shape=box];
n4 [label="M2 permite acción administrativa autorizada",shape=box];
n5 [label="Registrar auditoría y devolver respuesta",shape=box];
n0 -> n1;
n1 -> n2;
n2 -> n3 [label="Sí"];
n3 -> n4;
n4 -> n5;
error [label="Mostrar error o denegar permiso"]; n2 -> error [label="No"];error -> end;n5 -> end;
}