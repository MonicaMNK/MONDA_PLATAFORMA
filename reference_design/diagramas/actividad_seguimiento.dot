digraph G {
graph [fontname="Arial", bgcolor="white", nodesep=0.35, ranksep=0.45, pad=0.25]; node [fontname="Arial", fontsize=13, shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#64748b", margin="0.14,0.10"]; edge [fontname="Arial", fontsize=11, color="#475569", arrowsize=0.7];
rankdir=TB; start [shape=circle,label="",fillcolor=black,width=.12]; end [shape=doublecircle,label="",fillcolor=black,width=.16];start -> n0;
n0 [label="Docente selecciona curso y corte",shape=box];
n1 [label="M1 verifica permiso del curso",shape=box];
n2 [label="M7 agrega intentos y eventos",shape=box];
n3 [label="M7 compara con reglas y genera evidencia",shape=box];
n4 [label="¿Solicita reporte?",shape=diamond,fillcolor=white];
n5 [label="Seudonimizar, neutralizar CSV y exportar",shape=box];
n0 -> n1;
n1 -> n2;
n2 -> n3;
n3 -> n4;
n4 -> n5 [label="Sí"];
error [label="Mostrar indicadores y alertas"]; n4 -> error [label="No"];error -> end;n5 -> end;
}