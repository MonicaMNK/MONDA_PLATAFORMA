# Plataforma Monda - Entrega 2
# Copiar como .env y cambiar secretos antes de usar fuera de una máquina local.

POSTGRES_DB=monda
POSTGRES_USER=monda_app
POSTGRES_PASSWORD=monda_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://monda_app:monda_local_password@127.0.0.1:5432/monda

# Seguridad PI7
MONDA_SECRET_KEY=cambia-esta-clave-por-una-aleatoria-de-al-menos-32-bytes
ACCESS_MINUTES=30
REFRESH_DAYS=7
COOKIE_SECURE=0
MONDA_DEMO=1
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# RAG triple modo.
# auto: Gemini si existe GEMINI_API_KEY; de lo contrario fallback ligero.
# gemini: fuerza Gemini; ollama: fuerza Ollama; fallback: siempre ligero.
RAG_MODE=auto
RAG_ALLOW_FALLBACK=1
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.35
RAG_CANDIDATE_MULTIPLIER=4

# Gemini (modo recomendado/principal)
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Ollama 100% local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Archivos. Local en desarrollo; S3 preparado para AWS.
STORAGE_MODE=local
S3_BUCKET=
AWS_REGION=us-east-1

# Trazabilidad opcional; siempre existe traza JSONL local.
MLFLOW_TRACKING_URI=
